cat > .gitignore << 'EOF'
# Secrets
.env


# Database
*.db
*.db-wal
*.db-shm

# Python
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Reports generated by app
email-report-*.txt
duplicate-report-*.txt
EOF

.history/